<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context=".MainMenu">

    <Button
        android:id="@+id/sackButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="101dp"
        android:layout_marginEnd="0dp"
        android:text="INVENTARIO"
        android:textAlignment="center"
        android:textSize="25sp" />

    <ImageButton
        android:id="@+id/opcionesButtonMM"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        app:srcCompat="@android:drawable/ic_menu_preferences" />

    <Button
        android:id="@+id/gastoButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="190dp"
        android:text="MERMA"
        android:textSize="25sp" />

    <Button
        android:id="@+id/viajeButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="0dp"
        android:layout_marginBottom="173dp"
        android:text="ENTRADAS"
        android:textSize="24sp" />

    <Button
        android:id="@+id/notasButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_above="@+id/opcionesButtonMM"
        android:layout_alignParentStart="true"
        android:layout_marginStart="0dp"
        android:layout_marginBottom="33dp"
        android:text="SALIDAS"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/usuarioTextView"
        android:layout_width="358dp"
        android:layout_height="60dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="13dp"
        android:layout_marginTop="23dp"
        android:text="Bienvenido\nMMMMMMMMMMMMMMMM"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Headline"
        android:textSize="23sp" />

</RelativeLayout>